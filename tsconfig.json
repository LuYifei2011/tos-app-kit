{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"], "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.vue", "packages/*/tests/**/*.ts", "examples/ui-kit/**/*.ts", "examples/ui-kit/**/*.vue"]
}
